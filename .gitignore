# Xcode
*.xcodeproj/
!*.xcodeproj/project.xcworkspace/xcshareddata/
*.xcworkspace/
xcuserdata/
DerivedData/
build/
*.ipa
*.dSYM.zip
*.dSYM
*.xcresult

# Swift Package Manager
.build/
.swiftpm/
packages/*/.build/
apps/*/build/
# Any extra build folders (build2, build-release, …) from ad-hoc xcodebuild -derivedDataPath runs
apps/*/build*/

# Fastlane
**/fastlane/report.xml
**/fastlane/Preview.html
**/fastlane/screenshots/**/*.png
**/fastlane/test_output
**/fastlane/README.md

# Ruby
vendor/bundle/
.bundle/
# Created by local fastlane runs (Ruby versions differ between Macs and CI)
Gemfile.lock

# macOS
.DS_Store

# Secrets (never commit)
*.p8
*.p12
*.mobileprovision
.env
.env.*

# Claude Code agent worktrees
.claude/worktrees/
